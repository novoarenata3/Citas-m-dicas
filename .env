# Configuración Base de Datos PostgreSQL
POSTGRES_DB=ejercicio3_db
POSTGRES_USER=ejercicio3_admin
POSTGRES_PASSWORD=secure_ejercicio3_pass
DATABASE_URL=jdbc:postgresql://db:5432/ejercicio3_db

# Redis Config
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ Config
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=adminpass

# Ajustes de servicio
APP_PORT=8080
